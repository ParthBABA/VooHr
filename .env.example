# --- Flask / session ---
# Secret key used to sign Flask session cookies. Use a long random value in production.
SECRET_KEY=dev-secret-change-me
# Send session cookies only over HTTPS. Keep false locally, set true in production.
SESSION_COOKIE_SECURE=false

# --- MongoDB ---
# Connection string. Leave MONGODB_URI commented out to use a local mongod on default port.
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voohr

# --- Google OAuth (sign-in; create credentials at https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-client-secret

# --- Field-level envelope encryption via Google Cloud KMS ---
# Paste the FULL service account JSON as ONE line. Set this in Railway's
# dashboard as a secret, never commit it. Create the key at
# https://console.cloud.google.com/iam-admin/serviceaccounts
# (role: Cloud KMS CryptoKey Encrypter/Decrypter). For local dev, either set
# this or use GOOGLE_APPLICATION_CREDENTIALS pointing at the local key file.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}
GCP_PROJECT_ID=your-gcp-project-id
GCP_KMS_LOCATION=asia-south1
GCP_KMS_KEY_RING=voovr-asia
GCP_KMS_KEY=voovr-field-encryption-key

# --- Blind-index & JWT secrets ---
# Used to build searchable blind indexes over encrypted fields. Must be long and random.
HASH_INDEX_SECRET=change-me-random-hash-index-secret
# Secret used to sign JWTs (e.g. API auth).
JWT_SECRET=change-me-random-jwt-secret

# --- Email (password signup OTP delivery) ---
# Transactional emails are sent via the Brevo SMTP API
# (POST https://api.brevo.com/v3/smtp/email). Create an API key at
# https://app.brevo.com/settings/keys/api. The sender address must be a
# verified Brevo sender (https://app.brevo.com/senders).
BREVO_API_KEY=       # Brevo v3 API key (starts with xkeysib-)
BREVO_SENDER_EMAIL=  # verified sender address, e.g. no-reply@voovr.com
BREVO_SENDER_NAME=VooVr
PASSWORD_PEPPER=     # random 32+ char secret, separate from HASH_INDEX_SECRET

# --- Provider configuration ---
# STT: audio -> transcript (OpenAI Whisper). LLM: transcript analysis (DeepSeek).
# STORAGE: where audio files are kept ('local' or a cloud provider).
STT_PROVIDER=openai
LLM_PROVIDER=deepseek
STORAGE_PROVIDER=local

# --- Speech-to-text (audio -> transcript) ---
# STT_PROVIDER can be "openai" (OpenAI Whisper) or "deepgram" (Deepgram nova-2).
# For Deepgram, DEEPGRAM_API_KEY (listed under TTS below) is reused for STT —
# one key covers both speech-to-text and narration.
#   STT_PROVIDER=openai
#   STT_PROVIDER=deepgram
OPENAI_API_KEY=sk-...
# Analysis model used when LLM_PROVIDER is set to openai.
# OPENAI_ANALYSIS_MODEL=gpt-4o
# OpenAI Whisper STT (used when STT_PROVIDER=openai).
OPENAI_STT_MODEL=whisper-1
# Deepgram STT (used when STT_PROVIDER=deepgram). Defaults to "nova-2".
# DEEPGRAM_STT_MODEL=nova-2

# --- OCR (image -> transcript), uses OpenAI vision chat completions ---
VISION_PROVIDER=openai
# Model used to extract text from uploaded images (gpt-4o-mini supports vision).
# OPENAI_VISION_MODEL=gpt-4o-mini

# --- Text-to-speech (narration), uses Google Cloud TTS ---
GOOGLE_TTS_API_KEY=

# --- Text-to-speech (narration), uses Deepgram Aura TTS ---
# Voice defaults to "aura-2-thalia-en" (clear, confident feminine American
# English). Create an API key at https://console.deepgram.com.
# DEEPGRAM_API_KEY=
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- Transcript analysis (summary / sentiment / risks), uses DeepSeek ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANALYSIS_MODEL=deepseek-chat
# Per-request timeout for every LLM call, in seconds. Default 20s keeps a
# slow/hung upstream request from outliving the platform worker timeout
# (~30s) and serving a raw HTML error page instead of this app's JSON.
# LLM_REQUEST_TIMEOUT_SECONDS=20

# --- Behavioural Intelligence Framework ---
# Toggle the V2 framework (true/false). Off by default.
USE_V2_FRAMEWORK=false

# --- Audio storage ---
# Local directory where uploaded session audio is stored.
AUDIO_STORAGE_PATH=static/audio/sessions

# Optional overrides (defaults already sensible)
# STT_PROVIDER=openai        # or "deepgram"
# LLM_PROVIDER=deepseek
# OPENAI_STT_MODEL=whisper-1
# DEEPGRAM_STT_MODEL=nova-2
# DEEPSEEK_ANALYSIS_MODEL=deepseek-chat
