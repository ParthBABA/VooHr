# --- Flask / session ---
# Secret key used to sign Flask session cookies. Use a long random value in production.
SECRET_KEY=dev-secret-change-me
# Send session cookies only over HTTPS. Keep false locally, set true in production.
SESSION_COOKIE_SECURE=false

# --- MongoDB ---
# Connection string. Leave MONGODB_URI commented out to use a local mongod on default port.
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voohr

# --- Google OAuth (sign-in; create credentials at https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-client-secret

# --- GCP KMS (field-level envelope encryption for sensitive fields) ---
GCP_PROJECT_ID=my-gcp-project
GCP_KMS_LOCATION=asia-south1
GCP_KMS_KEY_RING=voovr-keyring
GCP_KMS_KEY=voovr-field-encryption-key

# --- Blind-index & JWT secrets ---
# Used to build searchable blind indexes over encrypted fields. Must be long and random.
HASH_INDEX_SECRET=change-me-random-hash-index-secret
# Secret used to sign JWTs (e.g. API auth).
JWT_SECRET=change-me-random-jwt-secret

# --- Provider configuration ---
# STT: audio -> transcript (OpenAI Whisper). LLM: transcript analysis (DeepSeek).
# STORAGE: where audio files are kept ('local' or a cloud provider).
STT_PROVIDER=openai
LLM_PROVIDER=deepseek
STORAGE_PROVIDER=local

# --- Speech-to-text (audio -> transcript), uses OpenAI Whisper ---
OPENAI_API_KEY=sk-...
# Analysis model used when LLM_PROVIDER is set to openai.
# OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1

# --- Transcript analysis (summary / sentiment / risks), uses DeepSeek ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANALYSIS_MODEL=deepseek-chat

# --- Behavioural Intelligence Framework ---
# Toggle the V2 framework (true/false). Off by default.
USE_V2_FRAMEWORK=false

# --- Audio storage ---
# Local directory where uploaded session audio is stored.
AUDIO_STORAGE_PATH=static/audio/sessions

# Optional overrides (defaults already sensible)
# STT_PROVIDER=openai
# LLM_PROVIDER=deepseek
# OPENAI_STT_MODEL=whisper-1
# DEEPSEEK_ANALYSIS_MODEL=deepseek-chat
