@@ -654,16 +654,23 @@ function clearFieldError(input){
 
   function deviceLabel(d){
     if (!d) return 'Unknown device';
+    // Show a simple, friendly device name (Laptop/Phone/Tablet) rather than
+    // the raw browser/OS string. Falls back to the detailed browser+OS combo
+    // for device types we don't have a friendly name for.
+    if (d.device_type === 'Desktop') return 'Laptop';
+    if (d.device_type === 'Mobile') return 'Phone';
+    if (d.device_type === 'Tablet') return 'Tablet';
     var parts = [];
-    // Treat absent/unparsed pieces ("Unknown") as missing so a session with
-    // no usable device metadata falls back cleanly instead of rendering
-    // the literal string "Unknown on Unknown".
     if (d.browser && d.browser !== 'Unknown') parts.push(d.browser);
     if (d.os && d.os !== 'Unknown') parts.push(d.os);
     return parts.length ? parts.join(' on ') : 'Unknown device';
   }
 
   function locationLabel(loc){
+    // Real per-IP geo lookup (see login_flow.py:_lookup_location). This only
+    // shows "Local network" when the session's IP genuinely couldn't be
+    // geolocated (private/local IP, or the lookup failed) — it is never a
+    // hardcoded value, so each session reflects its own actual city/region.
     if (!loc) return 'Local network';
     var parts = [];
     if (loc.city) parts.push(loc.city);
