node_modules/
venv/
.ven/
__pycache__/
*.pyc
.env
.env.local
.env.*.local

# Debug/log artifacts — should never be committed
debug_*.py
app_stdout.txt
app_stderr.txt
*.log

# Generated audio artifacts — session/TTS audio must NEVER be committed.
# Audio no longer lives under static/ (see providers/storage.py), but both
# locations are ignored so nothing slips back in.
static/audio/
audio_storage/

# Ad-hoc patch/diff files — should never be committed
*.patch
*.diff
